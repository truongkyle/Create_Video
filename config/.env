# Google Flow Automation Config

# Paths
COOKIES_PATH=config/cookies.json
JSON_INPUT_PATH=data/sample_input.json
SELECTORS_PATH=config/selectors.json
LOG_DIR=logs

# Flow URL
FLOW_URL=https://labs.google/fx/tools/flow

# Browser
HEADLESS=false
WINDOW_WIDTH=1440
WINDOW_HEIGHT=900

# Timing (seconds)
HUMAN_DELAY_MIN=2
HUMAN_DELAY_MAX=5
PAGE_LOAD_TIMEOUT=30
RENDER_TIMEOUT=600
DOWNLOAD_TIMEOUT=120

# Retry
MAX_STEP_RETRY=3
MAX_RELOAD_RETRY=3
MAX_FULL_RESTART=1
